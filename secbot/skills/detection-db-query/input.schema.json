{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["action"],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "phishing_summary",
        "phishing_history",
        "phishing_stats",
        "phishing_trend",
        "phishing_top_senders",
        "log_latest",
        "log_stats",
        "db_schema",
        "sql_query"
      ],
      "description": "Which query to run. Required."
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Page number for paginated queries (phishing_history)."
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50,
      "description": "Rows per page for paginated queries."
    },
    "search": {
      "type": "string",
      "maxLength": 200,
      "description": "Free-text search across sender and subject columns."
    },
    "filter": {
      "type": "string",
      "enum": ["phishing", "suspicious", "normal", "all"],
      "default": "all",
      "description": "Confidence-level filter for phishing_history."
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90,
      "default": 7,
      "description": "Look-back window in days for trend / top_senders."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "description": "Max rows returned (top_senders default 8, log_latest default 20)."
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Custom SELECT-only SQL query. UPDATE/INSERT/DELETE/DROP/ALTER are rejected."
    }
  }
}
